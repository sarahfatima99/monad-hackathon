PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data.sqlite

# Chain
# Monad testnet: CHAIN_ID=10143, MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Local Hardhat node (npx hardhat node): CHAIN_ID=31337, MONAD_TESTNET_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=10143
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0xDeployedMemoryGameAddress
OPERATOR_PRIVATE_KEY=0xoperatorPrivateKeyThatMatchesTheContractOperator

# Email — preferred: Resend (https://resend.com), a simple HTTP API that
# works cleanly on Vercel/serverless. Sign up, verify a sending domain (or use
# their shared onboarding domain for testing), create an API key, and set:
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Monad Memory Challenge <no-reply@yourdomain.com>"

# Fallback: traditional SMTP, only used if RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# If neither is set, verification codes are logged to the console instead of
# emailed (and to DEV_CODE_FILE below, if set) — useful for local testing.
DEV_CODE_FILE=./dev-codes.log

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173
