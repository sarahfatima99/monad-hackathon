PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data.sqlite

# Chain
# Monad testnet: CHAIN_ID=10143, MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Local Hardhat node (npx hardhat node): CHAIN_ID=31337, MONAD_TESTNET_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=10143
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0xDeployedMemoryGameAddress
OPERATOR_PRIVATE_KEY=0xoperatorPrivateKeyThatMatchesTheContractOperator

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=changeme
EMAIL_FROM="Monad Memory Challenge <no-reply@example.com>"

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173
